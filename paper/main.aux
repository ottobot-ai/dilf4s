\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {L0 threshold functions and their weight contributions.} \emph  {(a)}~Raw threshold values. Taktikos spans a wide range; Praos is a flat line. \emph  {(b)}~After squaring ($\alpha = 2$), the Taktikos curve spans a $47\times $ range in per-block weight contribution, while Praos contributes identical weight to every block. This is why superblock proofs require a difficulty gradient: without it, there is no notion of a block of greater difficulty to anchor the weight function.}}{14}{figure.caption.27}\protected@file@percent }
\newlabel{fig:l0curves}{{9}{14}{\textbf {L0 threshold functions and their weight contributions.} \emph {(a)}~Raw threshold values. Taktikos spans a wide range; Praos is a flat line. \emph {(b)}~After squaring ($\alpha = 2$), the Taktikos curve spans a $47\times $ range in per-block weight contribution, while Praos contributes identical weight to every block. This is why superblock proofs require a difficulty gradient: without it, there is no notion of a block of greater difficulty to anchor the weight function}{figure.caption.27}{}}
\newlabel{fig:l0curves@cref}{{[figure][9][]9}{[1][11][]14}}
