\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Slot-gap gating mechanism.} \emph  {(a)}~The scaling factor $\min (1, \delta /\gamma )$ as a function of L0 slot gap. Burst-forging blocks (red zone, gap 1--3) receive near-zero scaling. Honest blocks (green zone, gap 5--10) receive partial scaling. Full super-level credit requires gap $\geq \gamma = 15$. \emph  {(b)}~The effective L1 threshold at four slot gaps. A burst block at $\delta =1$ has its L1 threshold reduced to 6.7\% of the ungated value, directly suppressing super-level accumulation.}}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig:gating}{{2}{6}{\textbf {Slot-gap gating mechanism.} \emph {(a)}~The scaling factor $\min (1, \delta /\gamma )$ as a function of L0 slot gap. Burst-forging blocks (red zone, gap 1--3) receive near-zero scaling. Honest blocks (green zone, gap 5--10) receive partial scaling. Full super-level credit requires gap $\geq \gamma = 15$. \emph {(b)}~The effective L1 threshold at four slot gaps. A burst block at $\delta =1$ has its L1 threshold reduced to 6.7\% of the ungated value, directly suppressing super-level accumulation}{figure.caption.11}{}}
\newlabel{fig:gating@cref}{{[figure][2][]2}{[1][5][]6}}
