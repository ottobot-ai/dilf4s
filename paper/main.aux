\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The adversary dilemma.} Normalized chain growth rate (blue, decreasing) vs.\ weight per block (red, increasing) as a function of production gap. The green curve shows their product---the weight accumulation rate per slot. Burst-forging (gap 1--3) maximizes chain growth but produces near-zero weight per block. The honest mean gap ($\delta \approx 7$) operates near the weight-rate maximum. An adversary cannot simultaneously outpace the honest chain in length \emph  {and} weight.}}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:dilemma}{{3}{11}{\textbf {The adversary dilemma.} Normalized chain growth rate (blue, decreasing) vs.\ weight per block (red, increasing) as a function of production gap. The green curve shows their product---the weight accumulation rate per slot. Burst-forging (gap 1--3) maximizes chain growth but produces near-zero weight per block. The honest mean gap ($\delta \approx 7$) operates near the weight-rate maximum. An adversary cannot simultaneously outpace the honest chain in length \emph {and} weight}{figure.caption.14}{}}
\newlabel{fig:dilemma@cref}{{[figure][3][]3}{[1][6][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Super-level hit suppression under slot-gap gating.} Average super-level hits per 50-block race for three strategies: honest (gap $\sim $7), burst adversary (gap 1--2), and moderate adversary (gap 4--7). \emph  {(a)}~Without gating: all strategies achieve identical super-level hit rates---the shifted exponential alone provides no differentiation between honest and moderate adversary timing. \emph  {(b)}~With gating: burst adversary's L1 hits drop from 24.5 to 4.9 ($5\times $ reduction), while honest hits drop only to 14.5 ($1.7\times $ reduction). The moderate adversary is also suppressed relative to honest, closing the ``kink'' in the consistency bound.}}{12}{figure.caption.15}\protected@file@percent }
\newlabel{fig:suppression}{{4}{12}{\textbf {Super-level hit suppression under slot-gap gating.} Average super-level hits per 50-block race for three strategies: honest (gap $\sim $7), burst adversary (gap 1--2), and moderate adversary (gap 4--7). \emph {(a)}~Without gating: all strategies achieve identical super-level hit rates---the shifted exponential alone provides no differentiation between honest and moderate adversary timing. \emph {(b)}~With gating: burst adversary's L1 hits drop from 24.5 to 4.9 ($5\times $ reduction), while honest hits drop only to 14.5 ($1.7\times $ reduction). The moderate adversary is also suppressed relative to honest, closing the ``kink'' in the consistency bound}{figure.caption.15}{}}
\newlabel{fig:suppression@cref}{{[figure][4][]4}{[1][7][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Superblock density validation.} Target vs.\ observed conditional hit rates from 10M-slot simulation (log scale). All levels achieve target rates within 10\%, confirming that the shifted exponential parameterization produces the intended geometric density hierarchy. Level L0 represents base blocks (100\%); each subsequent level halves the rate.}}{12}{figure.caption.16}\protected@file@percent }
\newlabel{fig:density}{{5}{12}{\textbf {Superblock density validation.} Target vs.\ observed conditional hit rates from 10M-slot simulation (log scale). All levels achieve target rates within 10\%, confirming that the shifted exponential parameterization produces the intended geometric density hierarchy. Level L0 represents base blocks (100\%); each subsequent level halves the rate}{figure.caption.16}{}}
\newlabel{fig:density@cref}{{[figure][5][]5}{[1][7][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Fork race results.} \emph  {(a)}~Honest win rate by adversary strategy with $\alpha = 2$ over 50-block races. Blue bars: without gating (shifted exponential only). Orange bars: with slot-gap gating. The green arrow highlights the improvement at moderate gaps from 52\% to 75\%. Burst and fast adversaries are overwhelmingly defeated in both cases. \emph  {(b)}~Honest win rate vs.\ fork length against a burst adversary with gating. Even at 5 blocks, honest wins 98\% of races. At 50+ blocks, honest wins 100\%.}}{13}{figure.caption.19}\protected@file@percent }
\newlabel{fig:strategies}{{6}{13}{\textbf {Fork race results.} \emph {(a)}~Honest win rate by adversary strategy with $\alpha = 2$ over 50-block races. Blue bars: without gating (shifted exponential only). Orange bars: with slot-gap gating. The green arrow highlights the improvement at moderate gaps from 52\% to 75\%. Burst and fast adversaries are overwhelmingly defeated in both cases. \emph {(b)}~Honest win rate vs.\ fork length against a burst adversary with gating. Even at 5 blocks, honest wins 98\% of races. At 50+ blocks, honest wins 100\%}{figure.caption.19}{}}
\newlabel{fig:strategies@cref}{{[figure][6][]6}{[1][7][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Cumulative weight analysis.} \emph  {(a)}~A single 200-block fork race. The honest chain (blue) steadily outpaces the burst adversary (red). The green fill shows the growing weight gap. Honest finishes at $\sim 10\times $ the adversary's cumulative weight. \emph  {(b)}~Per-block weight distributions over 10{,}000 blocks. Honest blocks (blue) cluster around a higher mean, while adversary burst blocks (red) cluster near zero. The distributions have minimal overlap, meaning weight-based chain selection provides strong discrimination.}}{13}{figure.caption.21}\protected@file@percent }
\newlabel{fig:cumweight}{{7}{13}{\textbf {Cumulative weight analysis.} \emph {(a)}~A single 200-block fork race. The honest chain (blue) steadily outpaces the burst adversary (red). The green fill shows the growing weight gap. Honest finishes at $\sim 10\times $ the adversary's cumulative weight. \emph {(b)}~Per-block weight distributions over 10{,}000 blocks. Honest blocks (blue) cluster around a higher mean, while adversary burst blocks (red) cluster near zero. The distributions have minimal overlap, meaning weight-based chain selection provides strong discrimination}{figure.caption.21}{}}
\newlabel{fig:cumweight@cref}{{[figure][7][]7}{[1][7][]13}}
