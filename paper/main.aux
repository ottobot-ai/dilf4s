\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Fork race results.} \emph  {(a)}~Honest win rate by adversary strategy with $\alpha = 2$ over 50-block races. Blue bars: without gating (shifted exponential only). Orange bars: with slot-gap gating. The green arrow highlights the improvement at moderate gaps from 52\% to 75\%. Burst and fast adversaries are overwhelmingly defeated in both cases. \emph  {(b)}~Honest win rate vs.\ fork length against a burst adversary with gating. Even at 5 blocks, honest wins 98\% of races. At 50+ blocks, honest wins 100\%.}}{11}{figure.caption.20}\protected@file@percent }
\newlabel{fig:strategies}{{6}{11}{\textbf {Fork race results.} \emph {(a)}~Honest win rate by adversary strategy with $\alpha = 2$ over 50-block races. Blue bars: without gating (shifted exponential only). Orange bars: with slot-gap gating. The green arrow highlights the improvement at moderate gaps from 52\% to 75\%. Burst and fast adversaries are overwhelmingly defeated in both cases. \emph {(b)}~Honest win rate vs.\ fork length against a burst adversary with gating. Even at 5 blocks, honest wins 98\% of races. At 50+ blocks, honest wins 100\%}{figure.caption.20}{}}
\newlabel{fig:strategies@cref}{{[figure][6][]6}{[1][10][]11}}
\@writefile{toc}{\contentsline {paragraph}{Why the collapse occurs.}{11}{section*.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Cumulative weight analysis.} \emph  {(a)}~A single 200-block fork race. The honest chain (blue) steadily outpaces the burst adversary (red). The green fill shows the growing weight gap. Honest finishes at approximately $10\times $ the adversary's cumulative weight. \emph  {(b)}~Per-block weight distributions over 10{,}000 blocks. Honest blocks (blue) cluster around a higher mean, while adversary burst blocks (red) cluster near zero. The distributions have minimal overlap, meaning weight-based chain selection provides strong discrimination.}}{12}{figure.caption.22}\protected@file@percent }
\newlabel{fig:cumweight}{{7}{12}{\textbf {Cumulative weight analysis.} \emph {(a)}~A single 200-block fork race. The honest chain (blue) steadily outpaces the burst adversary (red). The green fill shows the growing weight gap. Honest finishes at approximately $10\times $ the adversary's cumulative weight. \emph {(b)}~Per-block weight distributions over 10{,}000 blocks. Honest blocks (blue) cluster around a higher mean, while adversary burst blocks (red) cluster near zero. The distributions have minimal overlap, meaning weight-based chain selection provides strong discrimination}{figure.caption.22}{}}
\newlabel{fig:cumweight@cref}{{[figure][7][]7}{[1][10][]12}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Fork race results: honest win percentage and weight ratio (honest cumulative weight / adversary cumulative weight) for 50-block races with $\alpha = 2$. Slot-gap gating strengthens honest advantage across all strategies, with the largest improvement at moderate gaps.}}{12}{table.caption.23}\protected@file@percent }
\newlabel{tab:results}{{2}{12}{Fork race results: honest win percentage and weight ratio (honest cumulative weight / adversary cumulative weight) for 50-block races with $\alpha = 2$. Slot-gap gating strengthens honest advantage across all strategies, with the largest improvement at moderate gaps}{table.caption.23}{}}
\newlabel{tab:results@cref}{{[table][2][]2}{[1][10][]12}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Light Client Overhead}{12}{subsection.5.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Fork race results under three L0 threshold functions. All use identical superblock parameters with $\alpha = 2$. The Taktikos LDD snowplow provides a $7.7\times $ threshold range between gap 1 and gap 7, which $\alpha = 2$ amplifies to a $47\times $ per-block weight range. Praos's constant threshold collapses this range to $1.0\times $, reducing weight-based chain selection to approximate super-level counting. The degradation is monotonic: as the L0 difficulty gradient flattens, honest advantage erodes at every adversary strategy.}}{13}{table.caption.24}\protected@file@percent }
\newlabel{tab:l0comparison}{{3}{13}{Fork race results under three L0 threshold functions. All use identical superblock parameters with $\alpha = 2$. The Taktikos LDD snowplow provides a $7.7\times $ threshold range between gap 1 and gap 7, which $\alpha = 2$ amplifies to a $47\times $ per-block weight range. Praos's constant threshold collapses this range to $1.0\times $, reducing weight-based chain selection to approximate super-level counting. The degradation is monotonic: as the L0 difficulty gradient flattens, honest advantage erodes at every adversary strategy}{table.caption.24}{}}
\newlabel{tab:l0comparison@cref}{{[table][3][]3}{[1][11][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Honest win rates under three L0 threshold functions.} Left: Taktikos LDD ($7.7\times $ threshold range) achieves near-perfect honest wins across all strategies. Center: Mild LDD ($1.4\times $ range) shows erosion at moderate and honest-like gaps. Right: Praos flat ($1.0\times $ range, no difficulty gradient) collapses to 69\% at moderate gaps---weight-based selection provides only marginal advantage over length-based selection. The 50\% line (dashed) represents a fair coin flip.}}{13}{figure.caption.26}\protected@file@percent }
\newlabel{fig:l0comparison}{{8}{13}{\textbf {Honest win rates under three L0 threshold functions.} Left: Taktikos LDD ($7.7\times $ threshold range) achieves near-perfect honest wins across all strategies. Center: Mild LDD ($1.4\times $ range) shows erosion at moderate and honest-like gaps. Right: Praos flat ($1.0\times $ range, no difficulty gradient) collapses to 69\% at moderate gaps---weight-based selection provides only marginal advantage over length-based selection. The 50\% line (dashed) represents a fair coin flip}{figure.caption.26}{}}
\newlabel{fig:l0comparison@cref}{{[figure][8][]8}{[1][11][]13}}
