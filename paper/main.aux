\newlabel{thm:dilemma@cref}{{[theorem][1][]1}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The adversary dilemma.} Normalized chain growth rate (blue, decreasing) vs.\ weight per block (red, increasing) as a function of production gap. The green curve shows their product---the weight accumulation rate per slot. Burst-forging (gap 1--3) maximizes chain growth but produces near-zero weight per block. The honest mean gap ($\delta \approx 7$) operates near the weight-rate maximum. An adversary cannot simultaneously outpace the honest chain in length \emph  {and} weight.}}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:dilemma}{{3}{8}{\textbf {The adversary dilemma.} Normalized chain growth rate (blue, decreasing) vs.\ weight per block (red, increasing) as a function of production gap. The green curve shows their product---the weight accumulation rate per slot. Burst-forging (gap 1--3) maximizes chain growth but produces near-zero weight per block. The honest mean gap ($\delta \approx 7$) operates near the weight-rate maximum. An adversary cannot simultaneously outpace the honest chain in length \emph {and} weight}{figure.caption.15}{}}
\newlabel{fig:dilemma@cref}{{[figure][3][]3}{[1][7][]8}}
