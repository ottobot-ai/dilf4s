\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Eligibility threshold functions.} \emph  {(a)}~Level-0 LDD snowplow: the threshold rises linearly with slot gap up to the cutoff $\gamma = 15$, then drops to baseline $f_B = 0.05$. Blocks at small slot gaps face low thresholds, making them harder to produce. \emph  {(b)}~Levels 1--7: shifted exponential thresholds as a function of base-block gap. The dormant period $\psi = 1$ guarantees zero threshold at gap~1 (burst resistance). Higher levels have larger scale parameters $\sigma _\mu $, rising more slowly. No single gap value simultaneously maximizes all curves.}}{4}{figure.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:thresholds}{{1}{4}{\textbf {Eligibility threshold functions.} \emph {(a)}~Level-0 LDD snowplow: the threshold rises linearly with slot gap up to the cutoff $\gamma = 15$, then drops to baseline $f_B = 0.05$. Blocks at small slot gaps face low thresholds, making them harder to produce. \emph {(b)}~Levels 1--7: shifted exponential thresholds as a function of base-block gap. The dormant period $\psi = 1$ guarantees zero threshold at gap~1 (burst resistance). Higher levels have larger scale parameters $\sigma _\mu $, rising more slowly. No single gap value simultaneously maximizes all curves}{figure.caption.6}{}}
\newlabel{fig:thresholds@cref}{{[figure][1][]1}{[1][3][]4}}
