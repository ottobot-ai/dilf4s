\newlabel{fig:density}{{5}{10}{\textbf {Superblock density validation.} Target vs.\ observed conditional hit rates from 10M-slot simulation (log scale). All levels achieve target rates within 10\%, confirming that the shifted exponential parameterization produces the intended geometric density hierarchy. Level L0 represents base blocks (100\%); each subsequent level halves the rate}{figure.caption.17}{}}
\newlabel{fig:density@cref}{{[figure][5][]5}{[1][9][]10}}
